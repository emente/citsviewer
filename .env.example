# Copy this file to .env and fill in real values. .env itself is
# git-ignored so credentials never get committed. Same variable names as
# mqtt-bridge/.env.example, since both connect to the same its_bridge
# database.
MYSQL_HOST=127.0.0.1
MYSQL_USER=its_bridge
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=its_bridge

# Optional: mqtt-bridge's live-push WebSocket server (its own WS_HOST/
# WS_PORT, mqtt-bridge/.env.example) -- the host:port your BROWSER can
# reach it at, which is only the same as MYSQL_HOST if mqtt_to_mysql.py
# runs on the same machine as MySQL. Leave empty to disable (plain polling
# only, same as before this existed).
WS_URL=
